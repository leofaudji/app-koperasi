RewriteEngine On

# Block direct web access to internal documentation folder
RewriteRule ^docs(/.*)?$ - [F,L]


# 0. Force trailing slash for the main directory to ensure relative assets load correctly
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*)$ %{REQUEST_URI}/ [L,R=301]

# 1. Force trailing slash for portal to fix relative paths
RewriteRule ^portal$ %{REQUEST_URI}/ [L,R=301]

# 2. API Routes
RewriteRule ^api/(.*)$ api/index.php?route=$1 [QSA,L]

# 3. Portal Routes
# Match portal/ or portal/index.html and serve via portal/index.php
RewriteRule ^portal/$ portal/index.php [L]
RewriteRule ^portal/index\.html$ portal/index.php [L]

# 4. Root/Index Handler
RewriteRule ^$ index.php [L]
RewriteRule ^index\.html$ index.php [L]

# 5. SPA Fallback for Dashboard (Admin)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(?!api/|portal/|assets/|uploads/).*$ index.php [L]

# 6. Gzip / Deflate Compression (70-80% smaller network payloads)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2 application/font-woff
</IfModule>

# 7. Browser Caching for Static Assets (Instant reloads)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>


# ==============================================================================
# BLOKIR SELURUH AKSES WEB KE FOLDER DOKUMENTASI (DOCS)
# ==============================================================================
# Folder ini hanya untuk dokumentasi internal pengembang dan sistem AI.
# Tidak diizinkan diakses langsung via web browser / HTTP request.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
